# System
PUID=1000 # User ID to run as
PGID=1000 # Group ID to run as
TZ=America/Los_Angeles # Timezone

# Paths (NAS mount points)
MEDIA_PATH=/mnt/nas/media        # Root media directory on Ugreen NAS
CONFIG_PATH=/mnt/nas/configs     # App config/database storage

# Plex
PLEX_CLAIM=                       # Get from https://plex.tv/claim (valid 4 min)
PLEX_ADVERTISE_IP=                # Optional: your Pi 5 LAN IP e.g. http://192.168.1.x:32400/

# VPN (gluetun) - fill in your provider
VPN_SERVICE_PROVIDER=             # e.g. nordvpn, mullvad, protonvpn, surfshark, expressvpn
VPN_TYPE=openvpn                  # openvpn or wireguard
OPENVPN_USER=                     # VPN username or service credential
OPENVPN_PASSWORD=                 # VPN password
# For WireGuard providers:
# WIREGUARD_PRIVATE_KEY=          # Wireguard private key
# WIREGUARD_ADDRESSES=            # Wireguard addresses

# qBittorrent
QBIT_WEBUI_PORT=8080              # WebUI Port for qBittorrent

# Optional: Discord webhook for notifications
DISCORD_WEBHOOK_URL=              # Discord webhook url for notifications
